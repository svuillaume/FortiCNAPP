# ── GenAISec environment variables ───────────────────────────────────────────
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your DuckDNS token (get it from https://www.duckdns.org → your account page)
# 3. Run:              docker compose up -d
#
# .env is git-ignored — never commit real tokens.

DUCKDNS_TOKEN=your-duckdns-token-here
