# ── FortiCNAPP Blog — environment variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain (FQDN)
DOMAIN=foo.com

# Let's Encrypt — contact email
LE_EMAIL=foobar@foo.com

# DuckDNS token (from https://www.duckdns.org → your account → token)
DUCKDNS_TOKEN=xxxx-xxxx-xxxx

# Login credentials for the blog
# AUTH_PASS must be a bcrypt hash, NOT plain text.
# Generate it with:
#   docker run --rm caddy:latest caddy hash-password --plaintext 'yourpassword'
AUTH_USER=admin
AUTH_PASS=$2a$14$replace-with-caddy-hash-password-output

# HMAC secret for session cookies — generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Optional: use pre-existing cert (skips ACME/ZeroSSL)
# TLS_CERT=/etc/ssl/certs/blog.pem
# TLS_KEY=/etc/ssl/private/blog.key
