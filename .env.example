# ── FortiCNAPP Blog — environment variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain (FQDN)
DOMAIN=foo.com

# Let's Encrypt — contact email
LE_EMAIL=foobar@foo.com

# DuckDNS token (from https://www.duckdns.org → your account → token)
DUCKDNS_TOKEN=xxxx-xxxx-xxxx

# Optional: use pre-existing cert (skips ACME/ZeroSSL)
# TLS_CERT=/etc/ssl/certs/blog.pem
# TLS_KEY=/etc/ssl/private/blog.key
