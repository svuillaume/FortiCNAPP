{
    # ZeroSSL handles DuckDNS CAA SERVFAIL — Let's Encrypt does not
    email {env.LE_EMAIL}
    acme_ca https://acme.zerossl.com/v2/DV90
}

{env.DOMAIN} {

    # ── TLS via ZeroSSL DNS-01 challenge (DuckDNS) ────────────────────────────
    # Caddy sets the _acme-challenge TXT record via DuckDNS API — no port 80 needed.
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
        resolvers 8.8.8.8 1.1.1.1
    }

    # ── Compression ────────────────────────────────────────────────────────────
    encode gzip

    # ── Security & HTTPS-enforcement headers ──────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    nosniff
        X-Frame-Options           SAMEORIGIN
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           strict-origin-when-cross-origin
        -Server
    }

    # ── Basic auth ────────────────────────────────────────────────────────────
    # AUTH_PASS must be a bcrypt hash: docker run --rm caddy:latest caddy hash-password
    # AUTH_SECRET is reserved for future HMAC session middleware
    basicauth * {
        {env.AUTH_USER} {env.AUTH_PASS}
    }

    # ── Health probe (used by Docker healthcheck and load balancers) ──────────
    respond /health 200

    # ── Routing ───────────────────────────────────────────────────────────────
    # Redirect bare root and /FortiCNAPP (no trailing slash) to the canonical path
    redir /           /FortiCNAPP/ permanent
    redir /FortiCNAPP   /FortiCNAPP/ permanent

    # Serve the site at /FortiCNAPP/ — mirrors the GitHub Pages URL structure
    # so all internal absolute links (/FortiCNAPP/blog.html etc.) work unchanged
    handle /FortiCNAPP/* {
        root * /srv
        uri strip_prefix /FortiCNAPP
        file_server
    }
}
