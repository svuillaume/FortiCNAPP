{
    # ZeroSSL handles DuckDNS CAA SERVFAIL — Let's Encrypt does not
    email {env.LE_EMAIL}
    acme_ca https://acme.zerossl.com/v2/DV90
}

{env.DOMAIN} {

    # ── TLS via ZeroSSL DNS-01 challenge (DuckDNS) ────────────────────────────
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
        resolvers 8.8.8.8 1.1.1.1
    }

    # ── Compression ────────────────────────────────────────────────────────────
    encode gzip

    # ── Security & HTTPS-enforcement headers ──────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    nosniff
        X-Frame-Options           SAMEORIGIN
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           strict-origin-when-cross-origin
        -Server
    }

    # ── Health probe ──────────────────────────────────────────────────────────
    respond /health 200

    # ── Legacy redirects (old subpath URLs → root) ────────────────────────────
    redir /genAISeC*   / permanent
    redir /FortiCNAPP* / permanent

    # ── Serve site from root ──────────────────────────────────────────────────
    root * /srv
    file_server
}
